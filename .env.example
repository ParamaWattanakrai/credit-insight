# Path to the Excel "database" (relative to project root)
DATA_FILE=data/credit_card_customers.xlsx
# Seed file copied into DATA_FILE by `npm run reset-data`
SEED_FILE=data/seed/credit_card_customers_seed.xlsx
# Public URL of your published Tableau view (Tableau Public / Cloud / Server)
PUBLIC_TABLEAU_URL=

# Tableau Cloud Connected App (direct trust) — lets visitors see embedded views without a Tableau account.
# Server-side only; never commit the real values. Leave empty to use normal Tableau login instead.
TABLEAU_SERVER_URL=https://prod-apsoutheast-b.online.tableau.com
TABLEAU_CLIENT_ID=
TABLEAU_SECRET_ID=
TABLEAU_SECRET_VALUE=
# Tableau user (email on Tableau Cloud) whose permissions every visitor gets
TABLEAU_USER=

# --- docker compose only ---
# Host port and the exact URL you open in the browser (SvelteKit CSRF check)
PORT=3000
ORIGIN=http://localhost:3000
# Linux: uid/gid that owns ./data (run `id -u` and `id -g`)
UID=1000
GID=1000
